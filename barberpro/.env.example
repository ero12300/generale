# =====================================================================
# BarberPro — variabili d'ambiente
# Copia questo file in ".env.local" e compila i valori.
# Senza queste variabili l'app funziona in MODALITÀ DEMO (dati nel browser).
# =====================================================================

# URL pubblico del sito (usato da Stripe per i redirect). In locale:
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Firebase (Autenticazione + Database Firestore) ---
# Crea un progetto su https://console.firebase.google.com
# Aggiungi un'app Web e incolla qui i valori di configurazione.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Stripe (Pagamenti e abbonamento Pro) ---
# Chiavi da https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
# ID del prezzo ricorrente del piano Pro (price_...) creato in Stripe
STRIPE_PRICE_PRO=
# Segreto del webhook (whsec_...) da https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=
# (Opzionale) customer id di test per il portale di fatturazione
STRIPE_DEMO_CUSTOMER_ID=
