# ============================================================
# BarberOS — Configurazione ambiente
# Senza queste variabili l'app funziona in MODALITÀ DEMO
# (dati salvati nel browser, pagamenti simulati).
# ============================================================

# --- Firebase (console.firebase.google.com → Impostazioni progetto → Le tue app) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Stripe (dashboard.stripe.com → Sviluppatori → Chiavi API) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# ID prezzo degli abbonamenti (Stripe → Catalogo prodotti)
STRIPE_PRICE_PRO_MONTHLY=

# URL pubblico dell'app (per i redirect di Stripe)
NEXT_PUBLIC_APP_URL=http://localhost:3100
