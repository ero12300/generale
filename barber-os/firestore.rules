rules_version = '2';

// Regole di sicurezza Firestore per BarberOS.
//
// ATTENZIONE: queste regole sono un punto di partenza. Prima di andare in
// produzione attiva Firebase Authentication e limita le scritture in
// /transactions, /customers, /campaigns e /settings al solo titolare.
service cloud.firestore {
  match /databases/{database}/documents {

    // Servizi e campagne: lettura pubblica (servono alla pagina di prenotazione)
    match /services/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /campaigns/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Prenotazioni: i clienti possono crearle dalla pagina pubblica
    match /bookings/{id} {
      allow read, create: if true;
      allow update, delete: if request.auth != null;
    }

    // Clienti: creazione dalla pagina di prenotazione, gestione solo titolare
    match /customers/{id} {
      allow read, create: if true;
      allow update, delete: if request.auth != null;
    }

    // Incassi e impostazioni: solo titolare autenticato
    match /transactions/{id} {
      allow read, write: if request.auth != null;
    }
    match /settings/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
