# === Firebase (facoltativo: senza queste variabili l'app gira in demo locale) ===
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# ID del negozio (multi-tenant: un documento Firestore per negozio)
NEXT_PUBLIC_SHOP_ID=default

# === Stripe (facoltativo: senza queste variabili l'attivazione piani è simulata) ===
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price ID ricorrenti mensili creati su dashboard.stripe.com/products
STRIPE_PRICE_BASE=
STRIPE_PRICE_PRO=

# URL pubblico dell'app (per i redirect del Checkout)
NEXT_PUBLIC_APP_URL=http://localhost:3100
