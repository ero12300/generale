# ==============================================
# BarberOS — variabili d'ambiente
# Senza queste variabili l'app parte in MODALITÀ DEMO
# (dati in-memory, nessun servizio esterno richiesto)
# ==============================================

# --- Firebase (Firestore + Auth) ---
# Crea un progetto su https://console.firebase.google.com
# Project Settings > Service accounts > Generate new private key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Stripe (abbonamenti SaaS Base/Pro) ---
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price ID dei piani ricorrenti creati su Stripe
STRIPE_PRICE_BASE=
STRIPE_PRICE_PRO=

# URL pubblico dell'app (per redirect Stripe Checkout)
NEXT_PUBLIC_APP_URL=http://localhost:3100
