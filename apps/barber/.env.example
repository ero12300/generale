# ─────────────────────────────────────────────────────────────
# Lama d'Oro — configurazione ambiente
# Copia questo file in ".env.local" e compila i valori.
# Senza queste variabili l'app funziona in MODALITÀ DEMO
# (dati in memoria) per provare tutte le funzioni.
# ─────────────────────────────────────────────────────────────

# --- Firebase (Auth + Firestore) ---
# Trovi questi valori in: Firebase Console > Impostazioni progetto > Le tue app (Web)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# --- Stripe (abbonamenti Base/Pro) ---
# Trovi la Secret Key in: Stripe Dashboard > Sviluppatori > Chiavi API
STRIPE_SECRET_KEY=
# (Opzionale) ID del prezzo ricorrente del piano Pro creato su Stripe.
# Se vuoto, il prezzo viene creato al volo (29€/mese).
STRIPE_PRICE_PRO=
