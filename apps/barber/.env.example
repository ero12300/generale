# --- BarberFlow — variabili d'ambiente ---
# Senza queste variabili l'app funziona in MODALITÀ DEMO (dati in memoria).

# URL pubblico dell'app (per i redirect di Stripe Checkout)
NEXT_PUBLIC_APP_URL=http://localhost:3100

# --- Firebase (Firestore) ---
# JSON del service account Firebase (Console Firebase > Impostazioni progetto
# > Account di servizio > Genera nuova chiave privata). Incollare tutto il JSON su una riga.
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"..."}

# ID e nome del salone (multi-tenant semplice: un deployment per salone)
# BARBERFLOW_SHOP_ID=shop_mio_salone
# BARBERFLOW_SHOP_NAME=Il mio salone

# --- Stripe (abbonamenti Base/Pro) ---
# Chiave segreta (Dashboard Stripe > Sviluppatori > Chiavi API)
# STRIPE_SECRET_KEY=sk_test_...
# Secret del webhook (Dashboard Stripe > Webhook > endpoint /api/stripe/webhook)
# STRIPE_WEBHOOK_SECRET=whsec_...
# Price ID ricorrenti creati nel dashboard (facoltativi: senza, i prezzi
# vengono creati al volo con price_data)
# STRIPE_PRICE_BASE=price_...
# STRIPE_PRICE_PRO=price_...
