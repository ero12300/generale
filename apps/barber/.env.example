# =========================================================
# BarberOS — variabili d'ambiente
# Copia questo file in ".env.local" e compila i valori.
# Senza queste variabili l'app funziona in MODALITÀ DEMO
# (dati salvati nel browser, upgrade Pro simulato).
# =========================================================

# URL pubblico dell'app (usato per i redirect Stripe)
NEXT_PUBLIC_APP_URL=http://localhost:3001

# ---------- Firebase (Auth + Firestore) ----------
# Crea un progetto su https://console.firebase.google.com
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---------- Stripe (abbonamenti) ----------
# Chiavi da https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
# Price ID del piano Pro mensile (prodotto ricorrente in Stripe)
STRIPE_PRICE_PRO_MONTHLY=
# Secret del webhook (stripe listen / dashboard webhooks)
STRIPE_WEBHOOK_SECRET=
