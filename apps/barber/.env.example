# =============================================================================
# BarberPro - variabili di ambiente
# =============================================================================
# Copia questo file in `.env.local` e compila i valori.
# Senza queste variabili l'app funziona lo stesso in MODALITA' DEMO
# (dati finti in memoria, nessun salvataggio permanente).
# =============================================================================

# --- Firebase Web (client) ---------------------------------------------------
# Prendi questi valori dal file di configurazione Firebase del tuo progetto:
# Firebase Console -> Project Settings -> "Your apps" -> Web app -> Config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin (server, opzionale) --------------------------------------
# Per webhook Stripe e API server-side. Contenuto del service account JSON.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# --- Stripe (abbonamenti) ----------------------------------------------------
# Dashboard Stripe -> Developers -> API keys
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ID prezzi creati in Stripe (Products -> crea "BarberPro Pro" e "Business")
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_BUSINESS_MONTHLY=

# --- App --------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3100
NEXT_PUBLIC_APP_NAME=BarberPro
