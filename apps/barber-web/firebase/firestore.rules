rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function sameTenant(tenantId) {
      return signedIn() && request.auth.token.tenant_id == tenantId;
    }

    match /barbershops/{tenantId} {
      allow read, update: if sameTenant(tenantId);
      allow create: if signedIn();

      match /clients/{clientId} {
        allow read, write: if sameTenant(tenantId);
      }

      match /bookings/{bookingId} {
        allow read, write: if sameTenant(tenantId);
      }

      match /payments/{paymentId} {
        allow read, write: if sameTenant(tenantId);
      }

      match /campaigns/{campaignId} {
        allow read, write: if sameTenant(tenantId);
      }

      match /subscriptions/{subscriptionId} {
        allow read: if sameTenant(tenantId);
        allow write: if false;
      }
    }
  }
}
