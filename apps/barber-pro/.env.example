# =============================================================================
# BarberPro - variabili ambiente
# =============================================================================
# Copia questo file in .env.local e compila i valori.
# SENZA queste variabili l'app funziona in "modalità demo" con dati in-memory:
# perfetto per provarla subito, ma i dati si perdono al riavvio.
# =============================================================================

# --- Firebase (client, pubbliche) -------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin (server, per webhook Stripe) ----------------------------
# Genera una service account da Firebase Console > Impostazioni progetto > Service accounts.
# Incolla il JSON completo su una singola riga (o base64 encoded).
FIREBASE_SERVICE_ACCOUNT_JSON=

# --- Stripe -----------------------------------------------------------------
# Da https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# Firma del webhook, la ottieni da https://dashboard.stripe.com/test/webhooks
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Price ID Stripe per i piani (crea i prodotti in Stripe e incolla i price_...)
STRIPE_PRICE_PRO_MONTHLY=price_xxx
STRIPE_PRICE_BUSINESS_MONTHLY=price_xxx

# --- App --------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3100
