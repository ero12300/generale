{
  "name": "deal-desk-immobiliare",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @deal-desk/web dev",
    "dev:barber": "pnpm --filter @barberpro/web dev",
    "dev:doors": "pnpm --filter @doorforge/web dev",
    "build": "pnpm --filter @deal-desk/web build",
    "build:barber": "pnpm --filter @barberpro/web build",
    "build:doors": "pnpm --filter @doorforge/web build",
    "lint": "pnpm --filter @deal-desk/web lint",
    "lint:doors": "pnpm --filter @doorforge/web lint",
    "typecheck": "pnpm --filter @deal-desk/web typecheck",
    "typecheck:doors": "pnpm --filter @doorforge/web typecheck",
    "test": "pnpm --filter @deal-desk/web test",
    "test:doors": "pnpm --filter @doorforge/web test",
    "test:analytics": "cd services/analytics && python3 -m pytest -q",
    "provision": "node scripts/provision-production.mjs",
    "provision:barber": "node scripts/provision-barber.mjs",
    "provision:render": "node scripts/provision-render.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0"
}
