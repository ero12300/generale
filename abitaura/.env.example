# Use the EXISTING approved Firebase Boncordo Group project.
# Only Vercel server-side environment variables. NEVER put them in Git or NEXT_PUBLIC_.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# After Firebase + outbox writes have passed end-to-end verification:
# Set this to firebase. Default auto uses Firebase if credentials exist;
# without them it temporarily preserves the existing Supabase flow.
LEAD_STORAGE_MODE=auto

# Existing non-secret publishable key is used solely for temporary legacy fallback.
# Remove the legacy path only after a verified CRM migration.
# Do not add service-role or private keys to this file.
